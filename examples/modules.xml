<?xml version="1.0" encoding="UTF-8"?>
<exosettModel xmlns="https://www.exosett.com/xml/model"
              xmlns:sketch="https://www.exosett.com/xml/app/sketch"
              formatVersion="0.1.0">
  <metadata>
    <title>Three abstract accommodation modules</title>
    <author>Example model author</author>
  </metadata>
  <framePairs>
    <framePair id="pair-1">
      <placement x="0" y="0" z="0" unit="m" rotation="0"/>
      <grid widthCells="2" heightCells="2" depthCells="1"/>
      <accommodationFrame id="accommodation-frame-1">
        <cellDimensions width="6.2" height="3.1" depth="3.2" unit="m"/>
      </accommodationFrame>
      <serviceFrame id="service-frame-1">
        <cellDimensions width="6.2" height="3.1" depth="1.8" unit="m"/>
      </serviceFrame>
    </framePair>
  </framePairs>
  <moduleTypes>
    <accommodationModuleType id="example-module" name="Example module">
      <description>An abstract example envelope, not a prescribed ExoSett size.</description>
      <dimensions width="6.0" height="2.9" depth="3.0" unit="m"/>
    </accommodationModuleType>
  </moduleTypes>
  <modulePlacements>
    <accommodationModule id="module-1" typeRef="example-module" framePairRef="pair-1"
                         accommodationFrameRef="accommodation-frame-1" x="0" y="0" z="0"/>
    <accommodationModule id="module-2" typeRef="example-module" framePairRef="pair-1"
                         accommodationFrameRef="accommodation-frame-1" x="1" y="0" z="0"/>
    <accommodationModule id="module-3" typeRef="example-module" framePairRef="pair-1"
                         accommodationFrameRef="accommodation-frame-1" x="0" y="0" z="1"/>
  </modulePlacements>
  <applications>
    <sketch:view camera="isometric"/>
  </applications>
</exosettModel>

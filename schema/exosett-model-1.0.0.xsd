<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:ex="https://www.exosett.com/xml/model"
           targetNamespace="https://www.exosett.com/xml/model"
           elementFormDefault="qualified"
           attributeFormDefault="unqualified"
           version="1.0.0">

  <xs:annotation>
    <xs:documentation>ExoSett model interchange format, version 1.0.0.</xs:documentation>
  </xs:annotation>

  <xs:element name="exosettModel" type="ex:ModelType"/>

  <xs:complexType name="ModelType">
    <xs:sequence>
      <xs:element name="metadata" type="ex:MetadataType" minOccurs="0"/>
      <xs:element name="framePairs" type="ex:FramePairsType"/>
      <xs:element name="moduleTypes" type="ex:ModuleTypesType" minOccurs="0"/>
      <xs:element name="modulePlacements" type="ex:ModulePlacementsType" minOccurs="0"/>
      <xs:element name="applications" type="ex:ApplicationsType" minOccurs="0"/>
    </xs:sequence>
    <xs:attribute name="formatVersion" type="ex:FormatVersionType" use="required"/>
  </xs:complexType>

  <xs:simpleType name="FormatVersionType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="1.0.0"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="MetadataType">
    <xs:sequence>
      <xs:element name="title" type="xs:string" minOccurs="0"/>
      <xs:element name="description" type="xs:string" minOccurs="0"/>
      <xs:element name="author" type="xs:string" minOccurs="0"/>
      <xs:element name="organisation" type="xs:string" minOccurs="0"/>
      <xs:element name="designReference" type="ex:DesignReferenceType" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="DesignReferenceType">
    <xs:attribute name="authority" type="xs:string" use="required"/>
    <xs:attribute name="family" type="xs:string"/>
    <xs:attribute name="specification" type="xs:string"/>
    <xs:attribute name="revision" type="xs:string"/>
  </xs:complexType>

  <xs:complexType name="FramePairsType">
    <xs:sequence>
      <xs:element name="framePair" type="ex:FramePairType" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="FramePairType">
    <xs:sequence>
      <xs:element name="placement" type="ex:FramePairPlacementType"/>
      <xs:element name="grid" type="ex:GridType"/>
      <xs:element name="accommodationFrame" type="ex:FrameType"/>
      <xs:element name="serviceFrame" type="ex:FrameType"/>
    </xs:sequence>
    <xs:attribute name="id" type="xs:ID" use="required"/>
  </xs:complexType>

  <xs:complexType name="FramePairPlacementType">
    <xs:attribute name="x" type="xs:decimal" use="required"/>
    <xs:attribute name="y" type="xs:decimal" use="required"/>
    <xs:attribute name="z" type="xs:decimal" use="required"/>
    <xs:attribute name="unit" type="ex:LengthUnitType" use="required"/>
    <xs:attribute name="rotation" type="ex:QuarterTurnType" use="required"/>
  </xs:complexType>

  <xs:simpleType name="QuarterTurnType">
    <xs:restriction base="xs:nonNegativeInteger">
      <xs:enumeration value="0"/>
      <xs:enumeration value="90"/>
      <xs:enumeration value="180"/>
      <xs:enumeration value="270"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="GridType">
    <xs:attribute name="widthCells" type="xs:positiveInteger" use="required"/>
    <xs:attribute name="heightCells" type="xs:positiveInteger" use="required"/>
    <xs:attribute name="depthCells" type="xs:positiveInteger" use="required"/>
  </xs:complexType>

  <xs:complexType name="FrameType">
    <xs:sequence>
      <xs:element name="cellDimensions" type="ex:DimensionsType"/>
    </xs:sequence>
    <xs:attribute name="id" type="xs:ID" use="required"/>
  </xs:complexType>

  <xs:complexType name="ModuleTypesType">
    <xs:sequence>
      <xs:element name="accommodationModuleType" type="ex:ModuleType" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="ModuleType">
    <xs:sequence>
      <xs:element name="description" type="xs:string" minOccurs="0"/>
      <xs:element name="dimensions" type="ex:DimensionsType"/>
    </xs:sequence>
    <xs:attribute name="id" type="xs:ID" use="required"/>
    <xs:attribute name="name" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="DimensionsType">
    <xs:attribute name="width" type="ex:PositiveDecimalType" use="required"/>
    <xs:attribute name="height" type="ex:PositiveDecimalType" use="required"/>
    <xs:attribute name="depth" type="ex:PositiveDecimalType" use="required"/>
    <xs:attribute name="unit" type="ex:LengthUnitType" use="required"/>
  </xs:complexType>

  <xs:simpleType name="PositiveDecimalType">
    <xs:restriction base="xs:decimal">
      <xs:minExclusive value="0"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="LengthUnitType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="mm"/>
      <xs:enumeration value="cm"/>
      <xs:enumeration value="m"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="ModulePlacementsType">
    <xs:sequence>
      <xs:element name="accommodationModule" type="ex:ModulePlacementType" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="ModulePlacementType">
    <xs:attribute name="id" type="xs:ID" use="required"/>
    <xs:attribute name="typeRef" type="xs:IDREF" use="required"/>
    <xs:attribute name="framePairRef" type="xs:IDREF" use="required"/>
    <xs:attribute name="accommodationFrameRef" type="xs:IDREF" use="required"/>
    <xs:attribute name="x" type="xs:nonNegativeInteger" use="required"/>
    <xs:attribute name="y" type="xs:nonNegativeInteger" use="required"/>
    <xs:attribute name="z" type="xs:nonNegativeInteger" use="required"/>
  </xs:complexType>

  <xs:complexType name="ApplicationsType">
    <xs:sequence>
      <xs:any namespace="##other" processContents="lax" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

</xs:schema>
